{
  "name": "web",
  "version": "0.4.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test src/lib/*.test.ts src/lib/calling/*.test.ts src/lib/workspace-sync/*.test.ts && node --import ./scripts/register-typescript-test-loader.mjs --test src/components/workspace/calling-card.render.test.tsx",
    "api:generate": "openapi-ts -i ../api/openapi.yaml -o src/lib/api/generated -c @hey-api/client-fetch",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/lib/api/generated",
    "playwright": "node ./node_modules/@playwright/test/cli.js",
    "test:e2e": "pnpm playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@shadcn/react": "^0.3.0",
    "@telnyx/webrtc": "2.27.10",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
