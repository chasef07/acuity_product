{
  "name": "web",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-comments.mjs && knip",
    "typecheck": "tsc --noEmit",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:unit": "node --test src/lib/*.test.ts src/lib/calling/*.test.ts src/lib/workspace-sync/*.test.ts && node --import ./scripts/typescript-test-loader.mjs --test src/lib/clients/*.test.tsx src/lib/data/*.test.tsx src/components/workspace/*.render.test.tsx",
    "api:generate": "openapi-ts -i ../api/openapi.yaml -o src/lib/api/generated -c @hey-api/client-fetch",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/lib/api/generated",
    "playwright": "node ./node_modules/@playwright/test/cli.js",
    "test:e2e": "pnpm playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.2",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "5.104.1",
    "@telnyx/webrtc": "2.27.10",
    "better-auth": "~1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.2",
    "knip": "6.40.0",
    "postcss": "8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
