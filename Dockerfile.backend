FROM golang:1.27.3-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY backend ./backend
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/acuity ./backend/cmd/acuity

FROM alpine:3.24

# production or staging. Each image carries only its own environment's people
# and numbers, so a staging image cannot provision production.
ARG RELEASE_ENVIRONMENT

RUN apk add --no-cache ca-certificates \
    && addgroup -S acuity \
    && adduser -S -G acuity -u 10001 acuity
COPY --from=build /out/acuity /usr/local/bin/acuity
COPY config/${RELEASE_ENVIRONMENT}-provisioning.json /etc/acuity/provisioning.json
COPY config/${RELEASE_ENVIRONMENT}-task-responsibilities.json /etc/acuity/task-responsibilities.json
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/acuity"]
