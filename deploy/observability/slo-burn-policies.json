[
  {
    "displayName": "Acuity backend fast availability burn",
    "combiner": "AND",
    "enabled": true,
    "userLabels": {
      "acuity_slo": "critical-read-availability",
      "acuity_burn": "fast"
    },
    "documentation": {
      "mimeType": "text/markdown",
      "content": "Portal critical-read availability is consuming the 99.9% rolling 28-day error budget above 14.4x over both five minutes and one hour. Check `/v1/access` and `/v1/calling/state`, then inspect portal-api errors, latency, database dependencies, and the latest revision."
    },
    "alertStrategy": {
      "autoClose": "1800s"
    },
    "conditions": [
      {
        "displayName": "Five-minute availability burn above 14.4x",
        "conditionThreshold": {
          "filter": "select_slo_burn_rate(\"projects/${PROJECT_ID}/services/acuity-portal-backend/serviceLevelObjectives/critical-read-availability\", \"300s\")",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 14.4,
          "duration": "0s"
        }
      },
      {
        "displayName": "One-hour availability burn above 14.4x",
        "conditionThreshold": {
          "filter": "select_slo_burn_rate(\"projects/${PROJECT_ID}/services/acuity-portal-backend/serviceLevelObjectives/critical-read-availability\", \"3600s\")",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 14.4,
          "duration": "0s"
        }
      }
    ]
  },
  {
    "displayName": "Acuity backend slow availability burn",
    "combiner": "AND",
    "enabled": true,
    "userLabels": {
      "acuity_slo": "critical-read-availability",
      "acuity_burn": "slow"
    },
    "documentation": {
      "mimeType": "text/markdown",
      "content": "Portal critical-read availability is consuming the 99.9% rolling 28-day error budget above 6x over both thirty minutes and six hours. Review sustained portal-api failures and latency before the monthly error budget is exhausted."
    },
    "alertStrategy": {
      "autoClose": "1800s"
    },
    "conditions": [
      {
        "displayName": "Thirty-minute availability burn above 6x",
        "conditionThreshold": {
          "filter": "select_slo_burn_rate(\"projects/${PROJECT_ID}/services/acuity-portal-backend/serviceLevelObjectives/critical-read-availability\", \"1800s\")",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 6,
          "duration": "0s"
        }
      },
      {
        "displayName": "Six-hour availability burn above 6x",
        "conditionThreshold": {
          "filter": "select_slo_burn_rate(\"projects/${PROJECT_ID}/services/acuity-portal-backend/serviceLevelObjectives/critical-read-availability\", \"21600s\")",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 6,
          "duration": "0s"
        }
      }
    ]
  }
]
